# Django: sostituisci il valore di esempio con una chiave casuale locale.
DJANGO_SECRET_KEY=sostituisci-con-una-chiave-casuale-locale
DJANGO_DEBUG=True
# Liste separate da virgole, senza schema o porta per gli host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL: credenziali di esempio per lo sviluppo locale.
DB_NAME=smartquote
DB_USER=smartquote
DB_PASSWORD=smartquote_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Ollama: Docker prepara automaticamente il modello indicato.
# OLLAMA_BASE_URL viene usato nell'avvio manuale; Compose usa il servizio ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Frontend in Docker: l'indirizzo API deve essere raggiungibile dal browser.
# Per l'avvio manuale usa invece Frontend/.env.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
