# Django: sostituisci il valore di esempio con una chiave casuale locale.
DJANGO_SECRET_KEY=sostituisci-con-una-chiave-casuale-locale
DJANGO_DEBUG=False
# Liste separate da virgole, senza schema o porta per gli host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL: credenziali di esempio per lo sviluppo locale.
DB_NAME=smartquote
DB_USER=smartquote
DB_PASSWORD=smartquote_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Ollama: Docker prepara automaticamente il modello indicato.
# OLLAMA_BASE_URL viene usato nell'avvio manuale; in Docker Ollama è nello stesso container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Per il frontend locale configura VITE_API_BASE_URL in Frontend/.env.
# In Docker il frontend usa /api, sullo stesso host e porta della pagina.
# Compose rimuove i vecchi container del progetto dopo il passaggio al container unico.
# Database e modelli restano nei volumi persistenti.
COMPOSE_REMOVE_ORPHANS=true
